{
  "name": "intel-orchestrator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Single-operator CLI that turns a natural-language prompt into a delivered PDF intelligence brief by chaining Firecrawl and Claude.",
  "scripts": {
    "intel": "tsx src/cli.ts --",
    "intel:list-clients": "tsx src/cli.ts list-clients --",
    "intel:list-templates": "tsx src/cli.ts list-templates --",
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.0",
    "@mendable/firecrawl-js": "^1.0.0",
    "commander": "^12.0.0",
    "dotenv": "^16.4.0",
    "js-yaml": "^4.1.0",
    "md-to-pdf": "^5.2.0",
    "resend": "^4.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.14.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
